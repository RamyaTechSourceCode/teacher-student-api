    {
      "name": "Common Students",
      "item": [
        {
          "name": "CommonStudents - Ken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\npm.test(\"students include expected emails\", () => {\r\n  const list = pm.response.json().students;\r\n  [\"commonstudent1@gmail.com\", \"commonstudent2@gmail.com\", \"student_only_under_teacher_ken@gmail.com\"]\r\n    .forEach((e) => pm.expect(list).to.include(e));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/commonstudents?teacher=teacherken@gmail.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "commonstudents"
              ],
              "query": [
                {
                  "key": "teacher",
                  "value": "teacherken@gmail.com"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "CommonStudents - Ken & Joe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\npm.test(\"students include expected emails\", () => {\r\n  const list = pm.response.json().students;\r\n  [\"commonstudent1@gmail.com\", \"commonstudent2@gmail.com\"]\r\n    .forEach((e) => pm.expect(list).to.include(e));\r\n});\r\npm.test(\"Excludes students of only one teacher\", () =>\r\n  pm.expect(pm.response.json().students).to.not.include(\"student_only_under_teacher_ken@gmail.com\"));"
                ]
              }
            }
          ],
