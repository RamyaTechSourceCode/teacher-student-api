                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\npm.test(\"recipients include expected emails\", () => {\r\n  const list = pm.response.json().recipients;\r\n  [\"studentbob@gmail.com\", \"studentagnes@gmail.com\", \"studentmiche@gmail.com\"]\r\n    .forEach((e) => pm.expect(list).to.include(e));\r\n});\r\npm.test(\"No duplicates\", () => {\r\n  const r = pm.response.json().recipients;\r\n  pm.expect(new Set(r).size).to.eql(r.length);\r\n});"
